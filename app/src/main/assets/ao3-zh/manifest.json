{
  "manifest_version": 2,
  "name": "AO3 Translator",
  "version": "1.10.2",
  "description": "AO3 中文阅读体验增强（V-Lipset/ao3-chinese 内置版）",
  "browser_specific_settings": {
    "gecko": {
      "id": "ao3-zh@anglesgirl.com"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://archiveofourown.org/*",
        "https://archiveofourown.org/*",
        "http://archiveofourown.gay/*",
        "https://archiveofourown.gay/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
