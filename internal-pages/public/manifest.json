{
  "manifest_version": 2,
  "name": "Hyper Browser Internal Pages",
  "version": "1.38",
  "browser_specific_settings": {
    "gecko": {
      "id": "hyper-browser-internal@dadigua.com"
    }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "alarms",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "page": "background.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "scroll-restoration-content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "pull-refresh-content.js",
        "ime-focus-reveal-content.js",
        "media-keepalive-content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "background-video-enhancement-content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "reader-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://missav.ws/*", "https://*.missav.ws/*",
        "https://jable.tv/*", "https://*.jable.tv/*",
        "https://avjoy.me/*", "https://*.avjoy.me/*",
        "https://pigav.ws/*", "https://*.pigav.ws/*",
        "https://pigav.com/*", "https://*.pigav.com/*",
        "https://avtoday.io/*", "https://*.avtoday.io/*",
        "https://javhdporn.net/*", "https://*.javhdporn.net/*",
        "https://7mmtv.sx/*", "https://*.7mmtv.sx/*",
        "https://avple.tv/*", "https://*.avple.tv/*",
        "https://whos.tv/*", "https://*.whos.tv/*",
        "https://javday.app/*", "https://*.javday.app/*",
        "https://supjav.com/*", "https://*.supjav.com/*",
        "https://javrate.com/*", "https://*.javrate.com/*",
        "https://hentaimama.io/*", "https://*.hentaimama.io/*",
        "https://hentaimama.com/*", "https://*.hentaimama.com/*",
        "https://hentaimama.net/*", "https://*.hentaimama.net/*",
        "https://rouvb1.xyz/*", "https://*.rouvb1.xyz/*",
        "https://rou.video/*", "https://*.rou.video/*"
      ],
      "js": ["jav-search-collector.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
